using System.Collections.Concurrent;
using System.Reflection;
using Shared.Contracts.DTOs;
using Shared.Contracts.Enums;
using OrderService.Interfaces;

namespace OrderService.Services;

public class OrderService : IOrderService
{
    private readonly ConcurrentDictionary<Guid, OrderResponse> _store = new();

    public Task<OrderResponse> CreateOrderAsync(CreateOrderRequest request)
    {
        var response = Activator.CreateInstance<OrderResponse>()!;
        CopyMatchingProperties(request, response);

        // Ensure Id
        var id = EnsureGuidId(response);
        // Ensure Status = Pending
        SetStatus(response, OrderStatus.Pending);

        _store[id] = response;
        return Task.FromResult(response);
    }

    public Task<OrderResponse?> GetOrderByIdAsync(Guid id)
    {
        _store.TryGetValue(id, out var resp);
        return Task.FromResult(resp);
    }

    public Task<List<OrderResponse>> GetOrdersAsync(OrderStatus? status = null)
    {
        var list = _store.Values.ToList();
        if (status.HasValue)
        {
            list = list.Where(r => {
                var s = GetStatus(r);
                return s.HasValue && s.Value == status.Value;
            }).ToList();
        }
        return Task.FromResult(list);
    }

    public Task<bool> CancelOrderAsync(Guid id)
    {
        if (!_store.TryGetValue(id, out var resp))
            return Task.FromResult(false);

        var current = GetStatus(resp);
        if (!current.HasValue || current.Value != OrderStatus.Pending)
            return Task.FromResult(false);

        SetStatus(resp, OrderStatus.Cancelled);
        _store[id] = resp;
        return Task.FromResult(true);
    }

    // --- Reflection helpers ---
    private static void CopyMatchingProperties(object from, object to)
    {
        var fromProps = from.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance);
        var toProps = to.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(p => p.CanWrite)
            .ToDictionary(p => p.Name, p => p, StringComparer.OrdinalIgnoreCase);

        foreach (var fp in fromProps)
        {
            if (toProps.TryGetValue(fp.Name, out var tp))
            {
                var val = fp.GetValue(from);
                if (val == null) continue;
                if (tp.PropertyType.IsAssignableFrom(fp.PropertyType))
                    tp.SetValue(to, val);
                else
                {
                    try { tp.SetValue(to, Convert.ChangeType(val, tp.PropertyType)); } catch { /* ignore */ }
                }
            }
        }
    }

    private static Guid EnsureGuidId(object resp)
    {
        var idProp = resp.GetType().GetProperty("Id", BindingFlags.Public | BindingFlags.Instance);
        if (idProp != null && idProp.CanWrite)
        {
            var cur = idProp.GetValue(resp);
            if (cur is Guid g && g != Guid.Empty) return g;
            var newid = Guid.NewGuid();
            idProp.SetValue(resp, newid);
            return newid;
        }

        // Fallback: create and return new guid (no place to store it on DTO)
        return Guid.NewGuid();
    }

    private static OrderStatus? GetStatus(object resp)
    {
        var prop = resp.GetType().GetProperty("Status", BindingFlags.Public | BindingFlags.Instance);
        if (prop == null) return null;
        var val = prop.GetValue(resp);
        if (val == null) return null;
        if (val is OrderStatus os) return os;
        try
        {
            return (OrderStatus)Enum.Parse(typeof(OrderStatus), val.ToString() ?? string.Empty, ignoreCase: true);
        }
        catch { return null; }
    }

    private static void SetStatus(object resp, OrderStatus status)
    {
        var prop = resp.GetType().GetProperty("Status", BindingFlags.Public | BindingFlags.Instance);
        if (prop == null || !prop.CanWrite) return;
        if (prop.PropertyType.IsAssignableFrom(typeof(OrderStatus)))
            prop.SetValue(resp, status);
        else
        {
            // try set by name
            prop.SetValue(resp, status.ToString());
        }
    }
}
