using Microsoft.Data.Sqlite;

if (args.Length == 0)
{
    Console.WriteLine("Usage: dotnet run -- <path-to-db> [--dump N]");
    return;
}

var dbPath = args[0];
if (!File.Exists(dbPath))
{
    Console.WriteLine($"Database file not found: {dbPath}");
    return;
}

bool doDump = args.Length >= 2 && (args[1] == "--dump" || args[1] == "-d");
int dumpCount = 10;
if (doDump && args.Length >= 3 && int.TryParse(args[2], out var n))
    dumpCount = n;

using var conn = new SqliteConnection($"Data Source={dbPath}");
conn.Open();

using (var cmd = conn.CreateCommand())
{
    cmd.CommandText = "SELECT count(*) FROM OutboxMessages WHERE PublishedAtUtc IS NULL;";
    var scalar = cmd.ExecuteScalar();
    long count = 0;
    if (scalar != null && scalar != DBNull.Value)
        count = Convert.ToInt64(scalar);

    Console.WriteLine(count);
}

if (doDump)
{
    using var cmd = conn.CreateCommand();
    cmd.CommandText = $"SELECT Id, EventType, CreatedAtUtc, PublishedAtUtc, RetryCount, Error, Payload FROM OutboxMessages ORDER BY CreatedAtUtc LIMIT {dumpCount};";
    using var rdr = cmd.ExecuteReader();
    Console.WriteLine();
    Console.WriteLine($"First {dumpCount} rows in OutboxMessages (if any):");
    while (rdr.Read())
    {
        var id = rdr.GetGuid(0);
        var eventType = rdr.IsDBNull(1) ? "" : rdr.GetString(1);
        var created = rdr.IsDBNull(2) ? "" : rdr.GetString(2);
        var published = rdr.IsDBNull(3) ? "NULL" : rdr.GetString(3);
        var retry = rdr.IsDBNull(4) ? 0 : rdr.GetInt32(4);
        var error = rdr.IsDBNull(5) ? "" : rdr.GetString(5);
        var payload = rdr.IsDBNull(6) ? "" : rdr.GetString(6);

        Console.WriteLine("----------------------------------------");
        Console.WriteLine($"Id: {id}");
        Console.WriteLine($"EventType: {eventType}");
        Console.WriteLine($"CreatedAtUtc: {created}");
        Console.WriteLine($"PublishedAtUtc: {published}");
        Console.WriteLine($"RetryCount: {retry}");
        Console.WriteLine($"Error: {error}");
        Console.WriteLine($"Payload: {payload}");
    }
}
